			local function G(a, b, c, d, k1, k2)
				local va, vb, vc, vd = v[a], v[b], v[c], v[d]
				va = W[k1] + (va + vb)
				vd = ROR64(XOR64(vd, va), 32)
				vc = vc + vd
				vb = ROR64(XOR64(vb, vc), 24)
				va = W[k2] + (va + vb)
				vd = ROR64(XOR64(vd, va), 16)
				vc = vc + vd
				vb = ROL64(XOR64(vb, vc), 1)
