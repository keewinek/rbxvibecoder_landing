		end
		local max_reg = ceil(size / 4)
		for j = 1, max_reg do
			stack[j] = HEX(stack[j])
		end
		return sub(gsub(table_concat(stack, "", 1, max_reg), "(..)(..)(..)(..)", "%4%3%2%1"), 1, size * 2)
	end

	local function partial(message_part)
		if message_part then
			if tail then
